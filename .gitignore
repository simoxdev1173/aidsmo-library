# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.cache/

# Python tooling cache
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local uploads
/public/uploads/*
!/public/uploads/.gitkeep

# generated PDF.js browser assets
/public/pdfjs/

# local database backups and timestamp rollback snapshots
/db-backup/

# Source PDFs cached by the homepage preview generator
/.local/publication-pdfs/

# generated database client
/lib/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
